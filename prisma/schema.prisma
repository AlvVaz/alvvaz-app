generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClientStatus {
  new
  active
  vip
  archived
}

enum MagazineItemKind {
  PDF
  IMAGE
}

enum ContractStatus {
  pending
  signed
  paid
  canceled
}

enum PromotionStatus {
  live
  draft
  paused
}

enum AdminRole {
  owner
  admin
  tech
}

model AdminUser {
  id           String    @id @default(cuid())
  username     String?   @unique
  email        String    @unique
  passwordHash String
  role         AdminRole @default(admin)
  lastLoginAt  DateTime?
  lastPasswordResetAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Client {
  id        String       @id @default(cuid())
  name      String
  contact   String
  tags      String[]
  notes     String
  status    ClientStatus
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  contracts Contract[]
}

model MagazineIssue {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  publishedAt String?
  thumbnailUrl String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       MagazineItem[]
}

model MagazineItem {
  id        String           @id @default(cuid())
  issueId   String
  issue     MagazineIssue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  title     String
  kind      MagazineItemKind
  fileUrl   String
  sortOrder Int
  createdAt DateTime         @default(now())
  metadata  Json

  @@index([issueId, sortOrder])
}

model Trip {
  id             String   @id @default(cuid())
  clientName     String
  destination    String
  hotel          String
  supplier       String
  organizer      String
  passengerCount Int
  departureDate  String?
  returnDate     String?
  travelers      Json
  notes          String
  status         ContractStatus @default(pending)
  prepStage      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  contracts      Contract[]
}

model Contract {
  id            String   @id @default(cuid())
  clientId      String?
  tripId        String?
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  trip          Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)
  contractNumber String?  @unique
  reservationDate String?
  seller         String?
  agency         String?
  clientName     String
  destination    String
  hotel          String?
  supplier       String?
  organizer      String?
  passengerCount Int?
  departureDate  String?
  returnDate     String?
  travelers      Json
  description    String?
  notes          String?
  totalPrice     String?
  firstPayment   String?
  balanceDue     String?
  liquidationDate String?
  status         ContractStatus @default(pending)
  isSigned       Boolean  @default(false)
  isPaid         Boolean  @default(false)
  title         String
  fileUrl       String?
  storageBucket String?
  storagePath   String?
  mimeType      String?
  size          Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  metadata      Json

  @@index([clientId])
  @@index([tripId])
}

model Promotion {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  destinationCity String
  destinationState String
  durationDays    Int
  durationNights  Int?
  priceFrom       Int
  category        String
  budget          String
  summary         String
  description     String?
  includes        String[]
  excludes        String[]
  itinerary       String[]
  activities      String[]
  availableFrom   String?
  availableTo     String?
  hotelName       String?
  hotelCategory   String?
  ctaLabel        String?
  ctaLink         String?
  tags            String[]
  status          PromotionStatus  @default(draft)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  images          PromotionImage[]

  @@index([status, sortOrder])
}

model PromotionImage {
  id           String    @id @default(cuid())
  promotionId  String
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  fileUrl      String
  storageBucket String?
  storagePath  String?
  sortOrder    Int
  createdAt    DateTime  @default(now())

  @@index([promotionId, sortOrder])
}
